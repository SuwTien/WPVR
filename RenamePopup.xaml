<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renommer" Width="380" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FF1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tete : titre + bouton corbeille (placeholder, suppression reelle a l'etape 4) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Renommer" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>
            <Button x:Name="TrashButton" Grid.Column="1" Width="44" Height="44"
                    Background="#FFB5484C" BorderThickness="0" Foreground="White"
                    FontSize="18" Content="&#128465;"/>
        </Grid>

        <!-- Nom du fichier : partie editable + extension figee -->
        <Border Grid.Row="1" Background="#FF2D2D30" CornerRadius="4" Padding="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="NameTextBox" MinWidth="150" FontSize="18" Background="Transparent"
                         Foreground="White" BorderThickness="0" CaretBrush="White"/>
                <TextBlock x:Name="ExtensionLabel" FontSize="18" Foreground="#FF999999"
                           VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Annulation / validation -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Content="Annuler" Height="52"
                    FontSize="16" Margin="0,0,4,0"/>
            <Button x:Name="ValidateButton" Grid.Column="1" Content="Valider" Height="52"
                    FontSize="16" Margin="4,0,0,0" Background="#FF3C7A3C" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
